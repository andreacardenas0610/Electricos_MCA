# Neon PostgreSQL: use a pooled connection string and keep SSL enabled.
DATABASE_URL=postgresql://USER:PASSWORD@NEON_HOST/DBNAME?sslmode=require

# Required by the API; generate a private random value of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
FRONTEND_URL=http://localhost:5173
# Native app origins. Add any custom WebView origin used by the mobile application.
MOBILE_ORIGINS=capacitor://localhost,https://localhost,http://localhost

# Optional SMTP settings for verification and password-recovery messages.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
